	measure 'ZIP Requests' = ```
			
			        SUM ( fact_zip_monthly[Requests] )
			```
		formatString: #,0
		displayFolder: 5 Geography
		lineageTag: 0cedbac2-6c6f-4af9-933f-355b25792c0f

	measure 'ZIP Avg Response Days' = ```
			
			        VAR e = [Mature Month End]
			        RETURN
			            CALCULATE (
			                DIVIDE ( SUM ( fact_zip_monthly[ResponseHoursSum] ), SUM ( fact_zip_monthly[TimedClosed] ) ) / 24,
			                KEEPFILTERS ( dim_date[Date] <= e )
			            )
			```
		formatString: 0.0
		displayFolder: 5 Geography
		lineageTag: dc8f6067-550b-42dd-85ad-1852538bf368

	measure 'Top ZIP' = ```
			
			        VAR t = TOPN ( 1, FILTER ( VALUES ( dim_location[ZIP Label] ), [ZIP Requests] > 0 ), [ZIP Requests], DESC )
			        RETURN MAXX ( t, dim_location[ZIP Label] )
			```
		displayFolder: 5 Geography
		lineageTag: 63a78fe8-d4de-45fb-a03f-8a83520ef90b

	measure 'Top Borough' = ```
			
			        VAR t = TOPN ( 1, FILTER ( VALUES ( dim_borough[Borough] ), dim_borough[Borough] <> "Unspecified" ), [Requests], DESC )
			        RETURN MAXX ( t, dim_borough[Borough] )
			```
		displayFolder: 5 Geography
		lineageTag: 0848eaae-cda6-4d9e-bb23-4274718cf6b9

	measure 'Slowest Borough' = ```
			
			        VAR t = TOPN ( 1, FILTER ( VALUES ( dim_borough[Borough] ), dim_borough[Borough] <> "Unspecified" ), [Avg Response Days], DESC )
			        RETURN MAXX ( t, dim_borough[Borough] ) & "  ·  " & FORMAT ( MAXX ( t, [Avg Response Days] ), "0.0" ) & " days"
			```
		displayFolder: 5 Geography
		lineageTag: e1cd11b7-0d89-4a11-a8e8-a9d65bfa2b4d

	measure 'Fastest Borough' = ```
			
			        VAR t = TOPN ( 1, FILTER ( VALUES ( dim_borough[Borough] ), dim_borough[Borough] <> "Unspecified" ), [Avg Response Days], ASC )
			        RETURN MAXX ( t, dim_borough[Borough] ) & "  ·  " & FORMAT ( MAXX ( t, [Avg Response Days] ), "0.0" ) & " days"
			```
		displayFolder: 5 Geography
		lineageTag: 0e0a9410-0f14-45aa-89f5-bbf0e314cd26

	measure 'Top Complaint LFM' = ```
			
			        VAR t = TOPN ( 1, VALUES ( dim_complaint[ComplaintType] ), [Requests LFM], DESC )
			        RETURN MAXX ( t, dim_complaint[ComplaintType] )
			```
		displayFolder: 6 Complaints
		lineageTag: e1d05124-6d55-4418-b965-3b739ee7c885

	measure 'Fastest Growing Complaint' = ```
			
			        VAR t =
			            ADDCOLUMNS (
			                FILTER ( VALUES ( dim_complaint[ComplaintType] ), [Requests LFM Prior] >= 500 ),
			                "@growth", [Requests LFM MoM %]
			            )
			        VAR top1 = TOPN ( 1, t, [@growth], DESC )
			        RETURN MAXX ( top1, dim_complaint[ComplaintType] ) & "  ·  " & FORMAT ( MAXX ( top1, [@growth] ), "+0%;-0%" )
			```
		displayFolder: 6 Complaints
		lineageTag: 441cad5f-fe59-4082-8f8c-5e236317faab

	measure 'Complaint Types Count' = ```
			
			        DISTINCTCOUNT ( fact_requests_daily[ComplaintKey] )
			```
		formatString: 0
		displayFolder: 6 Complaints
		lineageTag: b7804301-fed9-4644-b2be-dc72dbf9e4f3

	measure 'Noise Share LFM' = ```
			
			        DIVIDE ( CALCULATE ( [Requests LFM], dim_category[Category] = "Noise" ), [Requests LFM] )
			```
		formatString: 0%;-0%;0%
		displayFolder: 6 Complaints
		lineageTag: 6b630fff-e23c-4c16-9621-a0ba8bf78bdc

	measure 'Best Agency' = ```
			
			        VAR t = TOPN ( 1, FILTER ( VALUES ( dim_agency[AgencyKey] ), [Requests] >= 5000 ), [% Within Target], DESC )
			        RETURN MAXX ( t, dim_agency[AgencyKey] ) & "  ·  " & FORMAT ( MAXX ( t, [% Within Target] ), "0%" )
			```
		displayFolder: 7 Agencies
		lineageTag: 9d0051e1-85b3-4a15-856c-2fdeda0621ea

	measure 'Worst Agency' = ```
			
			        VAR t = TOPN ( 1, FILTER ( VALUES ( dim_agency[AgencyKey] ), [Requests] >= 5000 ), [% Within Target], ASC )
			        RETURN MAXX ( t, dim_agency[AgencyKey] ) & "  ·  " & FORMAT ( MAXX ( t, [% Within Target] ), "0%" )
			```
		displayFolder: 7 Agencies
		lineageTag: a3c11d54-bf3f-4526-9307-a40954b283a8

	measure 'Arrow Requests MoM' = ```
			
			        VAR c = [Requests LFM MoM %]
			        RETURN IF ( c >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( c ), "0.0%" ) & " vs prior month"
			```
		displayFolder: 8 Display
		lineageTag: 9b16c8c8-99a9-4d4b-a5bf-c69da882cd42

	measure 'Arrow Response MoM' = ```
			
			        VAR c = [Avg Response MM Change %]
			        RETURN IF ( c >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( c ), "0.0%" ) & IF ( c >= 0, " slower", " faster" )
			```
		displayFolder: 8 Display
		lineageTag: 4e64a160-4d07-44e3-af15-e0fa47003a56

	measure 'Arrow Target MoM' = ```
			
			        VAR c = [% Within Target MM Change pts]
			        RETURN IF ( c >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( c ), "0.0" ) & " pts vs prior month"
			```
		displayFolder: 8 Display
		lineageTag: 37eb1d94-0469-4a01-ba8a-c7ad417c1764

	measure 'Color Response MoM' = ```
			
			        IF ( [Avg Response MM Change %] > 0, "#B91C1C", "#15803D" )
			```
		displayFolder: 8 Display
		lineageTag: e93629a5-a0a9-46bf-90be-fe5011fd6b84

	measure 'Color Target MoM' = ```
			
			        IF ( [% Within Target MM Change pts] < 0, "#B91C1C", "#15803D" )
			```
		displayFolder: 8 Display
		lineageTag: 07ededb5-7e18-4189-9570-abe1548ca5e0

	measure 'Color Target Level' = ```
			
			        VAR p = [% Within Target]
			        RETURN SWITCH ( TRUE (), ISBLANK ( p ), BLANK (), p >= 0.85, "#15803D", p >= 0.70, "#B45309", "#B91C1C" )
			```
		displayFolder: 8 Display
		lineageTag: 2bcdeadb-ef99-4719-94aa-4b36a1ec9276

	measure 'Title Overview' = ```
			
			        VAR c = [Requests LFM MoM %]
			        RETURN
			            "In " & [Last Full Month Label] & ", New Yorkers filed " & FORMAT ( [Requests LFM], "#,0" )
			                & " requests, " & IF ( c >= 0, "up ", "down " ) & FORMAT ( ABS ( c ), "0%" ) & " from the month before"
			```
		displayFolder: 8 Display
		lineageTag: 9f0bbf84-c2c8-41c2-acd2-02774e87b4bd

	measure 'Title Response' = ```
			
			        VAR c = [Avg Response MM Change %]
			        RETURN
			            "Requests opened in " & [Mature Month Label] & " took " & FORMAT ( [Avg Response Days MM], "0.0" )
			                & " days on average to close, " & FORMAT ( ABS ( c ), "0%" ) & IF ( c > 0, " slower", " faster" )
			                & " than the month before"
			```
		displayFolder: 8 Display
		lineageTag: 257e1724-3df2-4758-9393-8a2b6f7ea62f

	measure 'Title Map' = ```
			
			        "Where requests come from: " & [Top ZIP] & " filed the most"
			```
		displayFolder: 8 Display
		lineageTag: 3d6252f9-e92d-4f9a-a5bc-b3f1cc1949b8

	measure 'Title Agencies' = ```
			
			        "Agencies ranked by " & LOWER ( [Target Label] )
			```
		displayFolder: 8 Display
		lineageTag: a639a884-8cb3-41dc-a524-c5cf61ac4dad

	measure 'Title Complaint Detail' = ```
			
			        "Complaint: " & SELECTEDVALUE ( dim_complaint[ComplaintType], "several types" )
			```
		displayFolder: 8 Display
		lineageTag: 254414e4-5871-4550-b494-af47d4484ba6

	measure 'Footnote Mature' = ```
			
			        "Response times use requests opened at least 30 days ago (through " & FORMAT ( [Mature Month End], "mmm yyyy" )
			            & "), so recent requests that haven't had time to close don't make the numbers look better than they are."
			```
		displayFolder: 8 Display
		lineageTag: 52367b15-9a5b-4d75-b413-8e568872f357

	measure 'Note Open 31+' = FORMAT ( [% Open 31+ Days], "0%" ) & " open more than 30 days"
		displayFolder: 8 Display
		lineageTag: 62334c14-aca7-4c79-b9f7-16f9a3c806d8

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

