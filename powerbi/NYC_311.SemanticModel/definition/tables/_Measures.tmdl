table _Measures
	lineageTag: e1489dfd-c0aa-4106-a447-d7dad7606c36

	measure 'As Of Date' = ```
			
			        MAX ( refresh_info[DataAsOf] )
			```
		formatString: Short Date
		displayFolder: 0 Dates
		lineageTag: 2f4d9c6b-a313-4b40-9383-9245fb6a375d

	measure 'Last Full Month End' = ```
			
			        EOMONTH ( [As Of Date], -1 )
			```
		formatString: Short Date
		displayFolder: 0 Dates
		lineageTag: 97cba91c-ff5f-45ea-b127-6a4ecad146fd

	measure 'Mature Month End' = ```
			
			        EOMONTH ( [As Of Date] - 30, -1 )
			```
		formatString: Short Date
		displayFolder: 0 Dates
		lineageTag: df4ec135-a267-4ae0-8552-b7898204d95f

	measure 'Data As Of Label' = ```
			
			        "Data through " & FORMAT ( [As Of Date], "mmm d, yyyy" ) & "  ·  refreshed daily"
			```
		displayFolder: 0 Dates
		lineageTag: 326ef0f4-f4e4-49c2-82d0-b31f7360b30f

	measure 'Last Full Month Label' = ```
			
			        FORMAT ( [Last Full Month End], "mmmm yyyy" )
			```
		displayFolder: 0 Dates
		lineageTag: 65c93594-2192-4c3e-af89-b7ecfaba95d5

	measure 'Mature Month Label' = ```
			
			        FORMAT ( [Mature Month End], "mmmm yyyy" )
			```
		displayFolder: 0 Dates
		lineageTag: 222e1edd-2015-4531-a266-226c393f18e1

	measure Requests = ```
			
			        SUM ( fact_requests_daily[Requests] )
			```
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: a0dd4a12-ac5c-4f22-9a79-d0cf8d7c340c

	measure 'Closed Requests' = ```
			
			        SUM ( fact_requests_daily[Closed] )
			```
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: b1b83468-f56b-417d-988c-6bf79e626797

	measure '% Closed' = ```
			
			        DIVIDE ( [Closed Requests], [Requests] )
			```
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: 1 Volume
		lineageTag: 5f3e0e2d-48ba-4ad8-baa5-0b8741243ca1

	measure 'Requests per Day' = ```
			
			        DIVIDE ( [Requests], COUNTROWS ( dim_date ) )
			```
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 82182034-64bc-42a9-a252-e7ae5a76fb5d

	measure 'Requests 7-Day Avg' = ```
			
			        AVERAGEX ( DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -7, DAY ), [Requests] )
			```
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: edf62210-0994-4365-9e96-756132498200

	measure 'Requests 28-Day Avg' = ```
			
			        AVERAGEX ( DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -28, DAY ), [Requests] )
			```
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 4d8af017-fb2d-4f63-b78e-1d9d9253e085

	measure 'Busiest Weekday' = ```
			
			        VAR t = TOPN ( 1, VALUES ( dim_date[Weekday] ), [Requests per Day], DESC )
			        RETURN MAXX ( t, dim_date[Weekday] ) & "  ·  " & FORMAT ( MAXX ( t, [Requests per Day] ), "#,0" ) & " a day"
			```
		displayFolder: 1 Volume
		lineageTag: a781c5d5-1e65-484b-9a78-ccf1fbc87d58

	measure 'Requests LFM' = ```
			
			        VAR e = [Last Full Month End]
			        RETURN CALCULATE ( [Requests], DATESBETWEEN ( dim_date[Date], EOMONTH ( e, -1 ) + 1, e ) )
			```
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 97c5363c-4b10-4857-9439-85aa5b312156

	measure 'Requests LFM Prior' = ```
			
			        VAR e = EOMONTH ( [Last Full Month End], -1 )
			        RETURN CALCULATE ( [Requests], DATESBETWEEN ( dim_date[Date], EOMONTH ( e, -1 ) + 1, e ) )
			```
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: 61e24553-bde3-41d3-9ab3-0367fc5d30bc

	measure 'Requests LFM MoM %' = ```
			
			        DIVIDE ( [Requests LFM] - [Requests LFM Prior], [Requests LFM Prior] )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Volume
		lineageTag: 0edf6338-d249-4036-b4a5-c582489f373e

	measure 'Requests LFM Last Year' = ```
			
			        VAR e = EOMONTH ( [Last Full Month End], -12 )
			        RETURN CALCULATE ( [Requests], DATESBETWEEN ( dim_date[Date], EOMONTH ( e, -1 ) + 1, e ) )
			```
		formatString: #,0
		displayFolder: 1 Volume
		lineageTag: d865881a-a05a-411d-ae83-9766d3cd784c

	measure 'Requests LFM YoY %' = ```
			
			        DIVIDE ( [Requests LFM] - [Requests LFM Last Year], [Requests LFM Last Year] )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Volume
		lineageTag: 70bb7a98-6764-4cbd-acbe-38665c5ac7c0

	measure 'Timed Closed' = ```
			
			        SUM ( fact_requests_daily[TimedClosed] )
			```
		formatString: #,0
		displayFolder: 2 Response Time
		lineageTag: fc12dd5f-90fe-43b6-bf7a-6f8f9518ca8f

	measure 'Avg Response Days (All)' = ```
			
			        DIVIDE ( SUM ( fact_requests_daily[ResponseHoursSum] ), [Timed Closed] ) / 24
			```
		formatString: 0.0
		displayFolder: 2 Response Time
		lineageTag: edc238f8-e242-4aa2-85ae-3380815df95c

	measure 'Avg Response Days' = ```
			
			        CALCULATE ( [Avg Response Days (All)], KEEPFILTERS ( dim_date[IsMatureCohort] = 1 ) )
			```
		formatString: 0.0
		displayFolder: 2 Response Time
		lineageTag: b74a6bdd-bbb5-45b8-975a-17e3ad1b5cbb

	measure 'Avg Response Days MM' = ```
			
			        VAR e = [Mature Month End]
			        RETURN CALCULATE ( [Avg Response Days (All)], DATESBETWEEN ( dim_date[Date], EOMONTH ( e, -1 ) + 1, e ) )
			```
		formatString: 0.0
		displayFolder: 2 Response Time
		lineageTag: 36802778-09da-4b5d-8a2e-c94f812d4d45

	measure 'Avg Response Days MM Prior' = ```
			
			        VAR e = EOMONTH ( [Mature Month End], -1 )
			        RETURN CALCULATE ( [Avg Response Days (All)], DATESBETWEEN ( dim_date[Date], EOMONTH ( e, -1 ) + 1, e ) )
			```
		formatString: 0.0
		displayFolder: 2 Response Time
		lineageTag: e1f44126-99ec-4f9d-8f97-721289112de3

	measure 'Avg Response MM Change %' = ```
			
			        DIVIDE ( [Avg Response Days MM] - [Avg Response Days MM Prior], [Avg Response Days MM Prior] )
			```
		displayFolder: 2 Response Time
		lineageTag: b4b6b195-d65b-4761-8b44-ff857a578251

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Selected Target Days' = ```
			
			        SELECTEDVALUE ( 'Target Days'[Target Days], 7 )
			```
		formatString: 0
		displayFolder: 3 Target
		lineageTag: d128b4d4-61cc-4593-840f-b981c450ddfa

	measure 'Within Target Count' = ```
			
			        SWITCH (
			            [Selected Target Days],
			            1,  SUM ( fact_requests_daily[Within1d] ),
			            3,  SUM ( fact_requests_daily[Within3d] ),
			            7,  SUM ( fact_requests_daily[Within7d] ),
			            14, SUM ( fact_requests_daily[Within14d] ),
			            30, SUM ( fact_requests_daily[Within30d] )
			        )
			```
		formatString: #,0
		displayFolder: 3 Target
		lineageTag: 100abef8-dc71-448a-b03f-4f49b1778045

	measure '% Within Target' = ```
			
			        VAR cutoff = [As Of Date] - [Selected Target Days]
			        RETURN
			            CALCULATE ( DIVIDE ( [Within Target Count], [Requests] ), KEEPFILTERS ( dim_date[Date] <= cutoff ) )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Target
		lineageTag: 5b5103a2-566f-4146-bcc3-4155639ade70

	measure '% Within Target MM' = ```
			
			        VAR e = [Mature Month End]
			        RETURN CALCULATE ( [% Within Target], DATESBETWEEN ( dim_date[Date], EOMONTH ( e, -1 ) + 1, e ) )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Target
		lineageTag: 03cd8a20-05a0-464e-b3db-eada27c1338b

	measure '% Within Target MM Prior' = ```
			
			        VAR e = EOMONTH ( [Mature Month End], -1 )
			        RETURN CALCULATE ( [% Within Target], DATESBETWEEN ( dim_date[Date], EOMONTH ( e, -1 ) + 1, e ) )
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Target
		lineageTag: b97a1f42-251d-483d-b1df-8b4162bbb731

	measure '% Within Target MM Change pts' = ```
			
			        ( [% Within Target MM] - [% Within Target MM Prior] ) * 100
			```
		formatString: 0.0
		displayFolder: 3 Target
		lineageTag: 9923d06b-c9ea-4d20-b241-84cc00668f97

	measure 'Target Label' = ```
			
			        "% closed within " & [Selected Target Days] & IF ( [Selected Target Days] = 1, " day", " days" )
			```
		displayFolder: 3 Target
		lineageTag: c22559b3-03e7-4507-9af5-aad471ede124

