table 'Time Comparison'
	lineageTag: 55eb7b11-07bf-4822-be4b-3687713f09a0

	calculationGroup
		precedence: 1

		calculationItem Current = SELECTEDMEASURE ()

		calculationItem 'Prior Month' = ```
				CALCULATE ( SELECTEDMEASURE (), DATEADD ( dim_date[Date], -1, MONTH ) )
				
				```

		calculationItem 'MoM %' = ```
				VAR cur = SELECTEDMEASURE () VAR prv = CALCULATE ( SELECTEDMEASURE (), DATEADD ( dim_date[Date], -1, MONTH ) ) RETURN DIVIDE ( cur - prv, prv )
				
				```

			formatStringDefinition = ""

		calculationItem 'Same Month Last Year' = ```
				CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( dim_date[Date] ) )
				
				```

		calculationItem 'YoY %' = ```
				VAR cur = SELECTEDMEASURE () VAR prv = CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( dim_date[Date] ) ) RETURN DIVIDE ( cur - prv, prv )
				
				```

			formatStringDefinition = ""

		calculationItem 'Year to Date' = ```
				CALCULATE ( SELECTEDMEASURE (), DATESYTD ( dim_date[Date] ) )
				
				```

